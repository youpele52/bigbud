{
  "name": "@bigbud/contracts",
  "version": "0.1.613",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    },
    "./settings": {
      "types": "./src/core/settings.ts",
      "import": "./src/core/settings.ts",
      "require": "./src/core/settings.ts"
    },
    "./constants/*": "./src/constants/*",
    "./constants/project.constant": "./src/constants/project.constant.ts",
    "./constants/providerRuntime.constant": "./src/constants/providerRuntime.constant.ts",
    "./constants/settings.constant": "./src/constants/settings.constant.ts",
    "./core/baseSchemas": "./src/core/baseSchemas.ts",
    "./core/model": "./src/core/model.ts",
    "./core/settings.threadRetention": "./src/core/settings.threadRetention.ts",
    "./core/*": "./src/core/*",
    "./system-monitor/*": "./src/system-monitor/*",
    "./system-monitor/types": {
      "types": "./src/system-monitor/types.ts",
      "import": "./src/system-monitor/types.ts"
    },
    "./orchestration/*": "./src/orchestration/*",
    "./orchestration/providerRuntime.usage": "./src/orchestration/providerRuntime.usage.ts",
    "./orchestration/orchestration.catalog": "./src/orchestration/orchestration.catalog.ts",
    "./orchestration/orchestration.fork": "./src/orchestration/orchestration.fork.ts",
    "./orchestration/orchestration.delegationModelChoice": "./src/orchestration/orchestration.delegationModelChoice.ts",
    "./orchestration/orchestration.promptSuggestion": "./src/orchestration/orchestration.promptSuggestion.ts",
    "./orchestration/orchestration.search": "./src/orchestration/orchestration.search.ts",
    "./orchestration/orchestration.provider": "./src/orchestration/orchestration.provider.ts",
    "./orchestration/providerTurnLiveness": "./src/orchestration/providerTurnLiveness.ts",
    "./server/mobile": {
      "types": "./src/server/mobile.ts",
      "import": "./src/server/mobile.ts",
      "require": "./src/server/mobile.ts"
    },
    "./server/mobile.recovery": {
      "types": "./src/server/mobile.recovery.ts",
      "import": "./src/server/mobile.recovery.ts",
      "require": "./src/server/mobile.recovery.ts"
    },
    "./server/rpc.mobile": {
      "types": "./src/server/rpc.mobile.ts",
      "import": "./src/server/rpc.mobile.ts",
      "require": "./src/server/rpc.mobile.ts"
    },
    "./server/rpc.retention": "./src/server/rpc.retention.ts",
    "./server/rpc.worktrees": "./src/server/rpc.worktrees.ts",
    "./server/subagents": "./src/server/subagents.ts",
    "./server/server": "./src/server/server.ts",
    "./server/server.opencodeV2ThreadToolsSetup": "./src/server/server.opencodeV2ThreadToolsSetup.ts",
    "./server/rpc.opencodeV2ThreadToolsSetup": "./src/server/rpc.opencodeV2ThreadToolsSetup.ts",
    "./server/ipc.terminal": "./src/server/ipc.terminal.ts",
    "./terminal-owner/primitives": "./src/terminal-owner/primitives.ts",
    "./terminal-owner/identity": "./src/terminal-owner/identity.ts",
    "./terminal-owner/shutdown": "./src/terminal-owner/shutdown.ts",
    "./terminal-owner/auth": "./src/terminal-owner/auth.ts",
    "./server/server.remoteRestart": "./src/server/server.remoteRestart.ts",
    "./server/server.sshConfig": "./src/server/server.sshConfig.ts",
    "./server/server.remoteFolders": "./src/server/server.remoteFolders.ts",
    "./server/server.sshHostTrust": "./src/server/server.sshHostTrust.ts",
    "./server/threadRetention": "./src/server/threadRetention.ts",
    "./workspace/project": "./src/workspace/project.ts",
    "./workspace/*": "./src/workspace/*",
    "./server/*": "./src/server/*"
  },
  "scripts": {
    "dev": "tsdown src/index.ts --format esm,cjs --dts --watch --clean",
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean",
    "prepare": "node -e \"if (process.env.CF_PAGES || process.env.CLOUDFLARE) process.exit(0); process.exit(require('child_process').spawnSync('effect-language-service', ['patch'], { stdio: 'inherit', shell: true }).status ?? 1)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
