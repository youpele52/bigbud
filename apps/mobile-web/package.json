{
  "name": "@bigbud/mobile-web",
  "version": "0.1.613",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev-supervise.ts 'mobile-web=node dev.ts'",
    "build": "vite build",
    "build:desktop": "VITE_MOBILE_BASE=/mobile/ vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:desktop-reference": "tsc --noEmit --project tests/browser/desktop-shell-reference/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:browser": "node tests/browser/shell.mjs",
    "test:browser:isolation": "node tests/browser/thread-isolation.mjs",
    "test:browser:rejection-resume": "node tests/browser/rejection-resume.mjs",
    "test:browser:visual-viewport": "node tests/browser/visual-viewport.mjs",
    "test:browser:host-access:linux": "node tests/browser/mobile-host-access.linux.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@bigbud/contracts": "workspace:*",
    "@bigbud/shared": "workspace:*",
    "@bigbud/ui": "workspace:*",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@pierre/diffs": "^1.2.12",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.160.2",
    "class-variance-authority": "^0.7.1",
    "effect": "catalog:",
    "lucide-react": "^0.564.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "catalog:",
    "vite": "^8.0.0",
    "vitest": "catalog:"
  }
}
