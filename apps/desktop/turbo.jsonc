{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist-electron/**"],
    },
    "dev": {
      "dependsOn": ["@bigbud/server#build"],
      "persistent": true,
      "passThroughEnv": [
        "BIGBUD_SSH_OWNER",
        "BIGBUD_SSH_OWNER_BIN",
        "BIGBUD_SSH_OWNER_NORMAL_DEV_READY",
        "BIGBUD_SSH_OWNER_NORMAL_DEV_PROFILE",
      ],
    },
    "start": {
      "dependsOn": ["build", "@bigbud/web#build", "@bigbud/server#build"],
      "cache": false,
      "persistent": true,
    },
    "smoke-test": {
      "dependsOn": ["build", "@bigbud/web#build", "@bigbud/server#build"],
      "cache": false,
      "outputs": [],
    },
  },
}
