  <entry>
    <id>tag:github.com,2008:Repository/1217105994/v0.4.0-beta.4</id>
    <updated>2026-11-20T16:44:49Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/youpele52/bigbud/releases/tag/v0.4.0-beta.4"/>
    <title>bigbud v0.4.0-beta.4</title>
    <content type="html">&lt;h2&gt;What&#39;s Changed&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;CI hygiene: shared setup, main-only cache saves, timeouts, SHA pins (M1) by &lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/youpele52/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/youpele52&quot;&gt;@youpele52&lt;/a&gt; in &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;6511606989&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/youpele52/bigbud/issues/3&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/youpele52/bigbud/pull/3/hovercard&quot; href=&quot;https://github.com/youpele52/bigbud/pull/3&quot;&gt;#3&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;CI: parallel jobs and sharded server tests (M2 + M3) by &lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/youpele52/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/youpele52&quot;&gt;@youpele52&lt;/a&gt; in &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;6512737977&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/youpele52/bigbud/issues/4&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/youpele52/bigbud/pull/4/hovercard&quot; href=&quot;https://github.com/youpele52/bigbud/pull/4&quot;&gt;#4&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Stopped Windows helper timeouts from blocking updates on slow PCs by &lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/youpele52/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/youpele52&quot;&gt;@youpele52&lt;/a&gt; in &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;6514742886&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/youpele52/bigbud/issues/5&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/youpele52/bigbud/pull/5/hovercard&quot; href=&quot;https://github.com/youpele52/bigbud/pull/5&quot;&gt;#5&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;New Contributors&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/youpele52/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/youpele52&quot;&gt;@youpele52&lt;/a&gt; made their first contribution in &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;6511606989&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/youpele52/bigbud/issues/3&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/youpele52/bigbud/pull/3/hovercard&quot; href=&quot;https://github.com/youpele52/bigbud/pull/3&quot;&gt;#3&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
