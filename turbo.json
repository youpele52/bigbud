{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": ["TMPDIR", "TMP", "TEMP", "BIGBUD_DEV_RUNNER_PID"],
  "globalEnv": [
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "BIGBUD_LOG_WS_EVENTS",
    "BIGBUD_MODE",
    "BIGBUD_PORT",
    "MOBILE_WEB_PORT",
    "BIGBUD_DEV_WEB_PORT",
    "BIGBUD_DEV_REPO_ROOT",
    "BIGBUD_DEV_WEB_RESERVATION",
    "BIGBUD_DEV_INSTANCE_OFFSET",
    "BIGBUD_DEV_INSTANCE",
    "BIGBUD_PORT_OFFSET",
    "BIGBUD_NO_BROWSER",
    "BIGBUD_HOME",
    "BIGBUD_AUTH_TOKEN",
    "BIGBUD_DESKTOP_WS_URL",
    "BIGBUD_REMOTE_AGENT_TRANSPORT",
    "BIGBUD_REMOTE_AGENT_BINARY",
    "BIGBUD_REMOTE_AGENT_INSTALL_SOURCE_PATH",
    "BIGBUD_REMOTE_AGENT_INSTALL_SOURCE_URL",
    "BIGBUD_REMOTE_AGENT_RELEASE_REPOSITORY",
    "BIGBUD_REMOTE_AGENT_RELEASE_VERSION",
    "BIGBUD_LOCAL_WORKSPACE_AGENT_BINARY",
    "BIGBUD_SERVER_NATIVE_TARGET_ARCH",
    "BIGBUD_TRACE_MIN_LEVEL",
    "BIGBUD_TRACE_TIMING_ENABLED",
    "BIGBUD_TRACE_FILE",
    "BIGBUD_TRACE_MAX_BYTES",
    "BIGBUD_TRACE_MAX_FILES",
    "BIGBUD_TRACE_BATCH_WINDOW_MS",
    "BIGBUD_OTLP_TRACES_URL",
    "BIGBUD_OTLP_METRICS_URL",
    "BIGBUD_OTLP_EXPORT_INTERVAL_MS",
    "BIGBUD_OTLP_SERVICE_NAME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "dependsOn": ["@bigbud/contracts#build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
