# Release-only credential reference
#
# Do not commit a populated copy. Store these values as GitHub repository Actions
# secrets. This file documents the names and formats used by
# .github/workflows/release.yml; it is not loaded by the release workflow.

# macOS Developer ID certificate, exported from Keychain as a .p12 and base64-encoded
# as one line. Used to sign the macOS app and bundled native workspace watcher.
CSC_LINK=

# Password chosen when exporting the .p12 certificate referenced by CSC_LINK.
CSC_KEY_PASSWORD=

# Apple Developer account email used by Apple's notarization service.
APPLE_ID=

# Apple app-specific password for APPLE_ID. Create it in the Apple Account security
# settings; do not use the Apple ID's primary password.
APPLE_APP_SPECIFIC_PASSWORD=

# Ten-character Apple Developer Team ID that owns the Developer ID certificate.
APPLE_TEAM_ID=

# PEM-encoded Ed25519 PRIVATE key that signs remote-agent release manifests. In
# GitHub Actions, paste the complete multi-line PEM, including BEGIN/END lines.
# Generate a new key with: openssl genpkey -algorithm ED25519 -out bigbud-remote-agent-signing-key.pem
BIGBUD_REMOTE_AGENT_SIGNING_KEY=

# Stable identifier for the private key above. It labels signatures and the
# corresponding public key included in the published remote-agent install source.
# Use letters, digits, '.', '_', or '-'; start with a letter or digit; 64 chars max.
# Reuse it for every channel while the same private key is used. Change it only
# when rotating to a different private key.
BIGBUD_REMOTE_AGENT_SIGNING_KEY_ID=release-2026
