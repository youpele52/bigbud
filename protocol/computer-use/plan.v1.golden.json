{
  "format": "bigbud.computerUsePlan.v1",
  "driver": "cua-driver 0.38.0 darwin static live-schema profile",
  "cases": [
    {
      "name": "capture of a referenced target",
      "userDefault": "background",
      "action": {
        "schemaVersion": 2,
        "surface": "desktop",
        "action": "capture",
        "targetRef": "t1"
      },
      "plan": {
        "binding": "target",
        "steps": [
          {
            "kind": "driver",
            "tool": "get_window_state",
            "arguments": {
              "include_screenshot": true,
              "include_accessibility_tree": false
            },
            "stamp": ["session", "pid", "window_id"]
          }
        ]
      }
    },
    {
      "name": "capture of the genuine focused target",
      "userDefault": "background",
      "action": {
        "schemaVersion": 2,
        "surface": "desktop",
        "action": "capture"
      },
      "plan": {
        "binding": "focused_target",
        "steps": [
          {
            "kind": "driver",
            "tool": "get_window_state",
            "arguments": {
              "include_screenshot": true,
              "include_accessibility_tree": false
            },
            "stamp": ["session", "pid", "window_id"]
          }
        ]
      }
    },
    {
      "name": "page info adds a bounded element tree",
      "userDefault": "background",
      "action": {
        "schemaVersion": 2,
        "surface": "desktop",
        "action": "get_page_info",
        "targetRef": "t1"
      },
      "plan": {
        "binding": "target",
        "steps": [
          {
            "kind": "driver",
            "tool": "get_window_state",
            "arguments": {
              "include_screenshot": true,
              "include_accessibility_tree": true,
              "tree_format": "elements",
              "max_elements": 250,
              "max_depth": 25,
              "timeout_ms": 1000
            },
            "stamp": ["session", "pid", "window_id"]
          }
        ]
      }
    },
    {
      "name": "background click consumes the stamped capture",
      "userDefault": "background",
      "action": {
        "schemaVersion": 2,
        "surface": "desktop",
        "action": "click",
        "observationRef": "o1",
        "x": 10.5,
        "y": 20,
        "button": "right",
        "captureAfter": true
      },
      "plan": {
        "binding": "observation",
        "steps": [
          {
            "kind": "driver",
            "tool": "click",
            "arguments": {
              "x": 10.5,
              "y": 20,
              "delivery_mode": "background",
              "button": "right"
            },
            "stamp": ["session", "pid", "window_id", "capture_id"]
          }
        ],
        "captureAfter": {
          "kind": "driver",
          "tool": "get_window_state",
          "arguments": {
            "include_screenshot": true,
            "include_accessibility_tree": false
          },
          "stamp": ["session", "pid", "window_id"]
        }
      }
    },
    {
      "name": "foreground click uses a non-restoring prelude",
      "userDefault": "background",
      "action": {
        "schemaVersion": 2,
        "surface": "desktop",
        "action": "click",
        "observationRef": "o1",
        "x": 1,
        "y": 2,
        "delivery": "foreground"
      },
      "plan": {
        "binding": "observation",
        "steps": [
          {
            "kind": "driver",
            "tool": "bring_to_front",
            "arguments": {},
            "stamp": ["session", "pid", "window_id"]
          },
          {
            "kind": "owner",
            "step": "verify_foreground"
          },
          {
            "kind": "driver",
            "tool": "click",
            "arguments": {
              "x": 1,
              "y": 2,
              "delivery_mode": "foreground"
            },
            "stamp": ["session", "pid", "window_id", "capture_id"]
          }
        ]
      }
    },
    {
