          },
          {
            "kind": "driver",
            "tool": "scroll",
            "arguments": {
              "direction": "down",
              "amount": 30,
              "x": 5,
              "y": 6,
              "delivery_mode": "background"
            },
            "stamp": ["session", "pid", "window_id"]
          }
        ]
      }
