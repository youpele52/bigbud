+import { testEffect } from "./lib/effect"
+
+// Source unit: explicit in-memory SQLite/inbox graph only, no Session runner,
+// native binary, model, SDK/server host or production configuration.
+const it = testEffect(
+  AppNodeBuilder.build(
+    LayerNode.group([
+      Database.node,
+      SessionInbox.node,
+      SessionProjector.node,
+      KV.node,
+      NativeFamily.node,
+      Bus.node,
+      SessionStore.node,
+    ]),
+  ),
+)
+const seed = Effect.gen(function* () {
+  const database = yield* Database.Service
+  yield* database.db
+    .insert(ProjectTable)
+    .values({ id: Project.ID.global, worktree: AbsolutePath.make("/project"), sandboxes: [] })
+    .onConflictDoNothing()
+    .run()
+    .pipe(Effect.orDie)
+  const sessionID = SessionSchema.ID.make("ses_native_family")
+  yield* database.db
+    .insert(SessionTable)
+    .values({
+      id: sessionID,
+      project_id: Project.ID.global,
+      slug: sessionID,
+      directory: "/project",
+      title: "source unit",
+      version: "test",
+    })
+    .onConflictDoNothing()
+    .run()
+    .pipe(Effect.orDie)
+  return sessionID
+})
+const receipt = (notificationID: string) => ({
+  abi: "opencode.native-family.v1" as const,
+  rootID: "ses_native_family",
+  ownerID: "source-plugin",
+  generation: 0,
+  operationID: "native-operation",
+  parentID: "ses_native_family",
+  messageID: "msg_call",
+  callID: "call_native",
+  childID: "ses_child",
+  notificationID,
+  jobGeneration: 10,
+  status: "completed" as const,
+})
+
+it.live(
+  "native origin commits atomically with actual synthetic inbox admission and supports exact idempotent recovery",
+  () =>
+    Effect.gen(function* () {
+      const sessionID = yield* seed
+      const inbox = yield* SessionInbox.Service
+      const kv = yield* KV.Service
+      const id = SessionMessage.ID.make("msg_native_completion")
+      const origin = yield* NativeFamilyAdmission.proof(receipt(id), () => {}, { text: "native completion" })
+      const request = {
+        id,
+        sessionID,
+        item: { type: "synthetic" as const, delivery: "steer" as const, payload: { text: "native completion" } },
+        ...origin,
+      }
+      yield* inbox.admit(request)
+      expect(yield* kv.get(`native-family.v1/origin/${id}`)).toEqual(receipt(id))
+      expect((yield* inbox.admit(request)).id).toBe(id)
+    }),
+)
+
+it.live("caller-spoofed metadata cannot become a native origin by reusing its input ID", () =>
+  Effect.gen(function* () {
+    const sessionID = yield* seed
+    const inbox = yield* SessionInbox.Service
+    const kv = yield* KV.Service
+    const id = SessionMessage.ID.make("msg_forged_completion")
+    const item = {
+      type: "synthetic" as const,
+      delivery: "steer" as const,
+      payload: { text: "forged", metadata: { source: "subagent", childID: "ses_child" } },
+    }
+    yield* inbox.admit({ id, sessionID, item })
+    const origin = yield* NativeFamilyAdmission.proof(receipt(id), () => {}, item.payload)
+    expect((yield* Effect.exit(inbox.admit({ id, sessionID, item, ...origin })))._tag).toBe("Failure")
+    expect(yield* kv.get(`native-family.v1/origin/${id}`)).toBeUndefined()
+  }),
+)
+
+it.live("a Stop racing the admission transaction rolls back both inbox entry and native origin", () =>
+  Effect.gen(function* () {
+    const sessionID = yield* seed
+    const inbox = yield* SessionInbox.Service
+    const kv = yield* KV.Service
+    const database = yield* Database.Service
+    const id = SessionMessage.ID.make("msg_fenced_completion")
+    let checks = 0
+    const origin = yield* NativeFamilyAdmission.proof(
+      receipt(id),
+      () => {
+        if (++checks > 1) throw new Error("Stop fenced")
+      },
+      { text: "must roll back" },
+    )
+    expect(
+      (yield* Effect.exit(
+        inbox.admit({
+          id,
+          sessionID,
+          item: { type: "synthetic", delivery: "steer", payload: { text: "must roll back" } },
+          ...origin,
+        }),
+      ))._tag,
+    ).toBe("Failure")
+    expect(yield* kv.get(`native-family.v1/origin/${id}`)).toBeUndefined()
+    expect(yield* SessionInbox.find(database.db, id)).toBeUndefined()
+  }),
+)
+
+it.live(
+  "native terminal consumption is durable, excludes queued input, and blocks receipt replay without hiding history",
+  () =>
+    Effect.gen(function* () {
+      const sessionID = yield* seed
+      const inbox = yield* SessionInbox.Service
+      const family = yield* NativeFamily.Service
+      const database = yield* Database.Service
+      const kv = yield* KV.Service
+      const bus = yield* Bus.Service
+      const childID = SessionSchema.ID.make("ses_receipt_child")
+      yield* database.db
+        .insert(SessionTable)
+        .values({
+          id: childID,
+          parent_id: sessionID,
+          project_id: Project.ID.global,
+          slug: childID,
+          directory: "/project",
+          title: "child",
+          version: "test",
+        })
+        .run()
+        .pipe(Effect.orDie)
+      yield* Effect.promise(() => family.register("source-plugin", sessionID, 0, "msg_user"))
+      const ticket = (yield* Effect.promise(() => family.begin(sessionID, "msg_call", "call_native")))!
+      yield* Effect.promise(() => family.enroll(ticket, childID))
+      const id = SessionMessage.ID.make("msg_consumed_completion")
+      yield* Effect.promise(() => family.job(ticket, async () => ({ started_at: 10, notificationID: id })))
+      const proof = yield* NativeFamilyAdmission.proof({ ...receipt(id), ...ticket, childID }, () => {}, {
+        text: "native completion",
+      })
+      yield* inbox.admit({
+        id,
+        sessionID,
+        item: { type: "synthetic", delivery: "steer", payload: { text: "native completion" } },
+        ...proof,
+      })
+      const consume = yield* NativeFamilyAdmission.makeConsume()
+      yield* consume(sessionID)
+      expect(yield* kv.get(`native-family.v1/consumed/${id}`)).toBeUndefined()
+      yield* bus.publish(SessionEvent.InboxDelivered, { sessionID, inboxID: id })
+      yield* bus.publish(SessionEvent.Execution.Succeeded, { sessionID }, { commit: () => consume(sessionID) })
+      expect((yield* Effect.promise(() => family.receipt("source-plugin", sessionID, 0, id))).consumed).toBe(true)
+    }),
+)
+
+it.live("cancelled native input identity remains reserved against public reuse and native recovery", () =>
+  Effect.gen(function* () {
+    const sessionID = yield* seed
+    const inbox = yield* SessionInbox.Service
+    const bus = yield* Bus.Service
+    const kv = yield* KV.Service
+    const id = SessionMessage.ID.make("msg_cancelled_native_completion")
+    const native = receipt(id)
+    const payload = { text: "trusted native completion", metadata: { source: "subagent", childID: native.childID } }
+    const proof = yield* NativeFamilyAdmission.proof(native, () => {}, payload)
+    yield* inbox.admit({ id, sessionID, item: { type: "synthetic", delivery: "steer", payload }, ...proof })
+    yield* NativeFamilyAdmission.verify(native)
+    yield* inbox.cancel({ id, sessionID })
+    expect(yield* kv.get(`native-family.v1/reserved/${id}`)).toBeDefined()
+    expect(yield* kv.get(`native-family.v1/cancelled/${id}`)).toBe(true)
+    const reopened = yield* SessionInbox.make()
+    const attacker = {
+      id,
+      sessionID,
+      item: {
+        type: "synthetic" as const,
+        delivery: "steer" as const,
+        payload: { ...payload, text: "ATTACKER REPLACEMENT" },
+      },
+    }
+    expect((yield* Effect.exit(reopened.admit(attacker)))._tag).toBe("Failure")
+    expect((yield* Effect.exit(reopened.admit({ ...attacker, ...proof })))._tag).toBe("Failure")
+    expect((yield* Effect.exit(NativeFamilyAdmission.verify(native)))._tag).toBe("Failure")
+    expect((yield* Effect.exit(bus.publish(SessionEvent.InboxDelivered, { sessionID, inboxID: id })))._tag).toBe(
+      "Failure",
+    )
+  }),
+)
+
+it.live("immutable payload binding rejects a replaced incarnation even after event-only cancellation/recovery", () =>
+  Effect.gen(function* () {
+    const sessionID = yield* seed
+    const inbox = yield* SessionInbox.Service
+    const bus = yield* Bus.Service
+    const id = SessionMessage.ID.make("msg_native_payload_binding")
+    const native = receipt(id)
+    const payload = { text: "trusted", description: "native completion", metadata: { source: "subagent" } }
+    const proof = yield* NativeFamilyAdmission.proof(native, () => {}, payload)
+    yield* inbox.admit({ id, sessionID, item: { type: "synthetic", delivery: "steer", payload }, ...proof })
+    yield* NativeFamilyAdmission.verify(native)
+    // Replay/legacy cancellation may have no tombstone. The permanent reservation
+    // still blocks the public API, and the body binding rejects a privileged bad replay.
+    yield* bus.publish(SessionEvent.InboxCancelled, { sessionID, inboxID: id })
+    expect(
+      (yield* Effect.exit(
+        inbox.admit({ id, sessionID, item: { type: "synthetic", delivery: "steer", payload: { text: "attacker" } } }),
+      ))._tag,
+    ).toBe("Failure")
+    yield* bus.publish(SessionEvent.InboxEnqueued, {
+      sessionID,
+      inboxID: id,
+      item: { type: "synthetic", delivery: "steer", payload: { text: "attacker" } },
+    })
+    yield* bus.publish(SessionEvent.InboxDelivered, { sessionID, inboxID: id })
+    expect((yield* Effect.exit(NativeFamilyAdmission.verify(native)))._tag).toBe("Failure")
+  }),
+)
