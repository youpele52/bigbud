+      const jobs = yield* Job.Service
+      const root = Session.ID.make("ses_deleted_managed_root")
+      const child = Session.ID.make("ses_deleted_managed_child")
+      const ordinary = Session.ID.make("ses_deleted_ordinary")
+      yield* seedSessions(database, [root, ordinary])
+      yield* seedSessions(database, [child], { parent_id: root })
+      yield* Effect.promise(() => family.register("plugin", root, 0, "msg_root"))
+      const ticket = (yield* Effect.promise(() => family.begin(root, "msg_root", "call_child")))!
+      yield* Effect.promise(() => family.enroll(ticket, child))
+      for (const id of [root, child, ordinary])
+        yield* seedBackground(jobs, id, [{ id: `sh_${id}`, shellID: `sh_${id}`, command: "SCRIPTED ONLY" }])
+      for (const id of [child, root, ordinary])
+        yield* database.db.delete(SessionTable).where(eq(SessionTable.id, id)).run().pipe(Effect.orDie)
+      const scope = yield* Scope.make()
+      yield* Effect.addFinalizer(() => Scope.close(scope, Exit.void))
+      const freshJobs = yield* Job.make.pipe(Effect.provideService(Scope.Scope, scope))
+      const context = yield* buildExecution(scope, () => Effect.void, undefined, freshJobs)
+      yield* Context.get(context, SessionRestart.Service).resumeSuspendedSessions
+      expect((yield* freshJobs.pendingBackground).map((job) => job.id).toSorted()).toEqual(
+        [`sh_${root}`, `sh_${child}`].toSorted(),
+      )
+    }),
+)
diff --git a/packages/core/test/native-family-shell.test.ts b/packages/core/test/native-family-shell.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/core/test/native-family-shell.test.ts
@@ -0,0 +1,110 @@
+import { expect, test } from "bun:test"
+import { Deferred, Effect, Exit, Fiber } from "effect"
+import { NativeFamilyShell } from "../src/session/family.shell"
+import { NativeFamilyLedger } from "../src/session/family.ledger"
+import { NativeFamily } from "../src/session/family"
+import { ShellLifetime } from "../src/shell.lifetime"
+import type { Active } from "../src/shell.state"
+import type { AppProcess } from "@opencode/util/process"
+
+// Fake shell resources and actual scoped handoff; no process or native host starts.
+test.each([false, true])("Stop covers create-to-job handoff and cleanup uncertainty (failed=%s)", async (failed) => {
+  const values = new Map<string, unknown>()
+  const store = {
+    get: async (key: string) => structuredClone(values.get(key)),
+    put: async (key: string, value: unknown) => {
+      values.set(key, structuredClone(value))
+    },
+  }
+  const ledger = new NativeFamilyLedger.Ledger(store, async () => undefined)
+  await ledger.register("plugin", "ses_root", 0, "msg_user")
+  await Effect.runPromise(
+    Effect.scoped(
+      Effect.gen(function* () {
+        const acquired = yield* Deferred.make<void>()
+        const started = yield* Deferred.make<void>()
+        const terminated = yield* Deferred.make<void>()
+        let settled = false
+        const tool = yield* NativeFamilyShell.handoff("ses_root", (fault) =>
+          Effect.gen(function* () {
+            yield* Effect.acquireRelease(
+              Deferred.succeed(started, undefined).pipe(Effect.andThen(Deferred.await(acquired))),
+              () =>
+                Deferred.await(terminated).pipe(
+                  Effect.andThen(failed ? Effect.die(new Error("fake termination failed")) : Effect.void),
+                  Effect.catchCause((cause) => fault().pipe(Effect.andThen(Effect.failCause(cause)))),
+                ),
+            )
+            yield* Effect.never // Between creation and Job.start/progress acknowledgement.
+          }),
+        ).pipe(Effect.provideService(NativeFamily.Service, ledger), Effect.forkScoped)
+        yield* Deferred.await(started)
+        const run = Effect.runPromiseWith(yield* Effect.context())
+        const stop = yield* Effect.promise(() =>
+          ledger.stop("plugin", "ses_root", 0, {
+            cancel: () => run(Fiber.interrupt(tool)).then(() => {}),
+            drained: () => run(Fiber.await(tool)).then((exit) => !failed && Exit.isFailure(exit)),
+          }),
+        ).pipe(
+          Effect.tap(() =>
+            Effect.sync(() => {
+              settled = true
+            }),
+          ),
+          Effect.forkScoped,
+        )
+        yield* Effect.yieldNow
+        expect(settled).toBe(false)
+        yield* Deferred.succeed(acquired, undefined)
+        yield* Effect.yieldNow
+        expect(settled).toBe(false)
+        yield* Deferred.succeed(terminated, undefined)
+        expect((yield* Fiber.join(stop)).settled).toBe(!failed)
+      }),
+    ),
+  )
+  if (failed) {
+    const reopened = new NativeFamilyLedger.Ledger(store, async () => undefined)
+    expect((await reopened.inspect("plugin", "ses_root", 0)).uncertain).toBe(true)
+    await expect(reopened.register("plugin", "ses_root", 1, "msg_next")).rejects.toThrow()
+  }
+})
+
+test("interrupted creation waits for its late acknowledgement and physical cleanup", async () => {
+  await Effect.runPromise(
+    Effect.scoped(
+      Effect.gen(function* () {
+        const ready = yield* Deferred.make<Active, AppProcess.AppProcessError>()
+        const terminated = yield* Deferred.make<void>()
+        let removed = false,
+          interrupted = false
+        const creation = yield* ShellLifetime.created(ready, () =>
+          Deferred.await(terminated).pipe(
+            Effect.tap(() =>
+              Effect.sync(() => {
+                removed = true
+              }),
+            ),
+          ),
+        ).pipe(Effect.forkScoped)
+        const stopping = yield* Fiber.interrupt(creation).pipe(
+          Effect.tap(() =>
+            Effect.sync(() => {
+              interrupted = true
+            }),
+          ),
+          Effect.forkScoped,
+        )
+        yield* Effect.yieldNow
+        expect(interrupted).toBe(false)
+        // Only info.id is inspected by the creation-lifetime helper.
+        yield* Deferred.succeed(ready, { info: { id: "sh_late" } } as Active)
+        yield* Effect.yieldNow
+        expect(interrupted).toBe(false)
+        yield* Deferred.succeed(terminated, undefined)
+        yield* Fiber.join(stopping)
+        expect(removed).toBe(true)
+      }),
+    ),
+  )
+})
diff --git a/packages/core/test/plugin/host.integration.ts b/packages/core/test/plugin/host.integration.ts
new file mode 100644
--- /dev/null
+++ b/packages/core/test/plugin/host.integration.ts
@@ -0,0 +1,152 @@
+import { Credential } from "@opencode/core/credential"
+import { Integration } from "@opencode/core/integration"
+import { Plugin } from "@opencode/plugin/effect"
+import type { IntegrationMethod } from "@opencode/plugin/effect/integration"
+import { Effect } from "effect"
+export function integrationHost(integration: Integration.Interface): Plugin.Context["integration"] {
+  return {
+    list: () => Effect.die("unused integration.list"),
+    get: () => Effect.die("unused integration.get"),
+    connect: {
+      key: () => Effect.die("unused integration.connect.key"),
+      external: () => Effect.die("unused integration.connect.external"),
+    },
+    oauth: {
+      connect: () => Effect.die("unused integration.oauth.connect"),
+      status: () => Effect.die("unused integration.oauth.status"),
+      complete: () => Effect.die("unused integration.oauth.complete"),
+      cancel: () => Effect.die("unused integration.oauth.cancel"),
+    },
+    command: {
+      connect: () => Effect.die("unused integration.command.connect"),
+      status: () => Effect.die("unused integration.command.status"),
+      cancel: () => Effect.die("unused integration.command.cancel"),
+    },
+    reload: integration.reload,
+    connection: {
+      active: (id) => integration.connection.active(Integration.ID.make(id)),
+      resolve: (connection) =>
+        integration.connection.resolve(
+          connection.type === "credential" ? { ...connection, id: Credential.ID.make(connection.id) } : connection,
+        ),
+      status: (input) =>
+        integration.connection.status({
+          integrationID: Integration.ID.make(input.integrationID),
+          connection:
+            input.connection.type === "credential"
+              ? { ...input.connection, id: Credential.ID.make(input.connection.id) }
+              : input.connection,
+          status: input.status,
+        }),
+    },
+    transform: (callback) =>
+      integration.transform((editor) =>
+        callback({
+          list: () => editor.list().map((value) => ({ id: value.id, name: value.name })),
+          get: (id) => {
+            const value = editor.get(Integration.ID.make(id))
+            return value && { id: value.id, name: value.name }
+          },
+          update: (id, update) => editor.update(Integration.ID.make(id), update),
+          remove: (id) => editor.remove(Integration.ID.make(id)),
+          method: {
+            list: (id) => editor.method.list(Integration.ID.make(id)),
+            update: (input) => {
+              if ("authorize" in input) {
+                const methodID = Integration.MethodID.make(input.method.id)
+                const refresh = input.refresh
+                editor.method.update({
+                  integrationID: Integration.ID.make(input.integrationID),
+                  method: { ...input.method, id: methodID },
+                  authorize: (answer) =>
+                    input.authorize(answer).pipe(
+                      Effect.map((authorization) => {
+                        if (authorization.mode === "auto") {
+                          return {
+                            ...authorization,
+                            callback: authorization.callback.pipe(
+                              Effect.map((credential) =>
+                                Credential.OAuth.make({
+                                  ...credential,
+                                  methodID: Integration.MethodID.make(credential.methodID),
+                                }),
+                              ),
+                            ),
+                          }
+                        }
+                        return {
+                          ...authorization,
+                          callback: (code: string) =>
+                            authorization.callback(code).pipe(
+                              Effect.map((credential) =>
+                                Credential.OAuth.make({
+                                  ...credential,
+                                  methodID: Integration.MethodID.make(credential.methodID),
+                                }),
+                              ),
+                            ),
+                        }
+                      }),
+                    ),
+                  ...(refresh
+                    ? {
+                        refresh: (value: Credential.OAuth) =>
+                          refresh(value).pipe(
+                            Effect.map((next) =>
+                              Credential.OAuth.make({
+                                ...next,
+                                methodID: Integration.MethodID.make(next.methodID),
+                              }),
+                            ),
+                          ),
+                      }
+                    : {}),
+                  ...(input.label ? { label: input.label } : {}),
+                })
+                return
+              }
+              if (input.method.type === "env") {
+                editor.method.update({
+                  integrationID: Integration.ID.make(input.integrationID),
+                  method: input.method,
+                })
+                return
+              }
+              if (input.method.type === "command") {
+                editor.method.update({
+                  integrationID: Integration.ID.make(input.integrationID),
+                  method: {
+                    ...input.method,
+                    id: Integration.MethodID.make(input.method.id),
+                  },
+                })
+                return
+              }
+              if (input.method.type === "external") {
+                editor.method.update({
+                  integrationID: Integration.ID.make(input.integrationID),
+                  method: {
+                    ...input.method,
+                    id: Integration.MethodID.make(input.method.id),
+                  },
+                })
+                return
+              }
+              editor.method.update({
+                integrationID: Integration.ID.make(input.integrationID),
+                method: input.method,
+              })
+            },
+            remove: (id, item) => editor.method.remove(Integration.ID.make(id), internalMethod(item)),
+          },
+        }),
+      ),
+  }
+}
+
+function internalMethod(value: IntegrationMethod): Integration.Method {
+  if (value.type === "oauth" || value.type === "command" || value.type === "external") {
+    return { ...value, id: Integration.MethodID.make(value.id) }
+  }
+  return value
+}
