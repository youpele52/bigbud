+++ b/packages/core/src/session/family.admission.ts
@@ -0,0 +1,100 @@
+export * as NativeFamilyAdmission from "./family.admission.js"
+
+import type { FamilyReceipt } from "@opencode/plugin/family"
+import { Effect } from "effect"
+import { Database } from "../database/database.js"
+import { KV } from "../kv.js"
+import { NativeFamily } from "./family.js"
+import { NativeFamilyReceipt } from "./family.receipt.js"
+import { SessionInbox } from "./inbox.js"
+import { SessionMessage } from "./message.js"
+import type { SessionSchema } from "./schema.js"
+import { SessionStore } from "./store.js"
+
+/** Called only from native completion delivery, never from the public synthetic handler.
+ * The stamp commits in the SAME transaction as inbox admission. A duplicate public
+ * synthetic ID must already have this native stamp or it is rejected, not adopted. */
+export const proof = Effect.fn("NativeFamilyAdmission.proof")(function* (
+  receipt: FamilyReceipt,
+  guard: () => void,
+  payload: { text: string; description?: string; metadata?: Record<string, unknown> },
+) {
+  const kv = yield* KV.Service
+  const key = `native-family.v1/origin/${receipt.notificationID}`
+  const reserved = `native-family.v1/reserved/${receipt.notificationID}`
+  const digest = NativeFamilyReceipt.payloadDigest(payload)
+  return {
+    commit: () =>
+      Effect.gen(function* () {
+        guard()
+        if ((yield* kv.get(reserved)) || (yield* kv.get(key)))
+          throw new Error("Native family admission identity is reserved")
+        yield* kv.set(reserved, { digest, operationID: receipt.operationID, sessionID: receipt.parentID })
+        yield* kv.set(key, { ...receipt })
+        guard()
+      }),
+    verifyExisting: () =>
+      Effect.gen(function* () {
+        guard()
+        const stored = yield* kv.get(key)
+        const binding = yield* kv.get(reserved)
+        if (
+          (yield* kv.get(`native-family.v1/cancelled/${receipt.notificationID}`)) ||
+          !binding ||
+          typeof binding !== "object" ||
+          !("digest" in binding) ||
+          binding.digest !== digest
+        )
+          throw new Error("Native family admission binding rejected")
+        if (JSON.stringify(stored) !== JSON.stringify(receipt))
+          throw new Error("Native family synthetic admission collision")
+      }),
+  }
+})
+
+/** Receipts authenticate the immutable body actually pending/projected, not just a reusable ID. */
+export const verify = Effect.fn("NativeFamilyAdmission.verify")(function* (receipt: FamilyReceipt) {
+  const kv = yield* KV.Service
+  const db = yield* Database.Service
+  const store = yield* SessionStore.Service
+  const id = SessionMessage.ID.make(receipt.notificationID)
+  const binding = yield* kv.get(`native-family.v1/reserved/${id}`)
+  if (
+    (yield* kv.get(`native-family.v1/cancelled/${id}`)) ||
+    !binding ||
+    typeof binding !== "object" ||
+    !("digest" in binding) ||
+    !("operationID" in binding) ||
+    !("sessionID" in binding) ||
+    binding.operationID !== receipt.operationID ||
+    binding.sessionID !== receipt.parentID
+  )
+    throw new Error("Native family admission reservation rejected")
+  const pending = yield* SessionInbox.find(db.db, id)
+  const projected = pending ? undefined : yield* store.message(id)
+  const body =
+    pending?.type === "synthetic" && pending.sessionID === receipt.parentID
+      ? pending.payload
+      : projected?.sessionID === receipt.parentID && projected.message.type === "synthetic"
+        ? projected.message
+        : undefined
+  NativeFamilyReceipt.verifyPayload(binding, receipt, body)
+})
+
+/** Terminal consumption shares the native terminal event's transaction. Queued
+ * inputs are not in projected context and cannot be consumed by an earlier idle. */
+export const makeConsume = Effect.fn("NativeFamilyAdmission.makeConsume")(function* () {
+  const kv = yield* KV.Service
+  const store = yield* SessionStore.Service
+  const family = yield* NativeFamily.Service
+  return (sessionID: SessionSchema.ID) =>
+    Effect.gen(function* () {
+      for (const id of family.completionIDs(sessionID)) {
+        const message = yield* store.message(SessionMessage.ID.make(id))
+        if (message?.sessionID !== sessionID || message.message.type !== "synthetic") continue
+        const proof = yield* kv.get(`native-family.v1/origin/${id}`)
+        if (!proof || typeof proof !== "object" || !("parentID" in proof) || proof.parentID !== sessionID) continue
+        yield* kv.set(`native-family.v1/consumed/${id}`, proof)
+      }
+    })
+})
