+import { NativeFamilyLedger } from "../src/session/family.ledger"
+import { NativeFamilyPlugin } from "../src/session/family.plugin"
+import { SessionStore } from "../src/session/store"
+
+// Real native plugin-domain implementation with scripted I/O services only.
+// No node graph, native executable, server, model, network or production state.
+test("native plugin cancel/drain handles all owned nested jobs, preserving foreign recovery records", async () => {
+  const values = new Map<string, unknown>()
+  const parents = new Map<string, string>()
+  const ledger = new NativeFamilyLedger.Ledger(
+    {
+      get: async (key) => values.get(key),
+      put: async (key, value) => {
+        values.set(key, structuredClone(value))
+      },
+    },
+    async (id) => parents.get(id),
+  )
+  await ledger.register("plugin", "ses_root", 0, "msg_user")
+  const first = (await ledger.begin("ses_root", "msg_call", "call_first"))!
+  parents.set("ses_child", "ses_root")
+  await ledger.enroll(first, "ses_child")
+  await ledger.job(first, async () => ({ started_at: 1, notificationID: "msg_first_notification" }))
+  const nested = (await ledger.begin("ses_child", "msg_nested", "call_nested"))!
+  parents.set("ses_nested", "ses_child")
+  await ledger.enroll(nested, "ses_nested")
+  const cancelled: string[] = [],
+    interrupted: string[] = []
+  let pending = [
+    { id: "ses_child", notificationID: "msg_first_notification", recovery: { kind: "subagent", family: first } },
+    {
+      id: "ses_foreign",
+      notificationID: "msg_foreign_notification",
+      recovery: { kind: "subagent", family: { ...first, rootID: "ses_foreign" } },
+    },
+  ] as unknown as Job.Background[]
+  const sessions = {
+    get: (id: string) => Effect.succeed({ id, parentID: parents.get(id), location: { directory: "/source-unit" } }),
+    active: Effect.succeed(new Set()),
+    inbox: () => Effect.succeed([]),
+    cancelInbox: () => Effect.void,
+    interrupt: (id: string) =>
+      Effect.sync(() => {
+        interrupted.push(id)
+        return true
+      }),
+  } as unknown as Session.Interface
+  const jobs = {
+    forSessions: () => Effect.succeed([]),
+    cancel: (id: string) =>
+      Effect.sync(() => {
+        cancelled.push(id)
+        return undefined
+      }),
+    pendingBackground: Effect.sync(() => pending),
+    completeBackground: (id: string) =>
+      Effect.sync(() => {
+        pending = pending.filter((row) => row.notificationID !== id)
+      }),
+  } as unknown as Job.Interface
+  const domain = await Effect.runPromise(
+    NativeFamilyPlugin.make("plugin", "/source-unit").pipe(
+      Effect.provideService(NativeFamily.Service, ledger),
+      Effect.provideService(Session.Service, sessions),
+      Effect.provideService(Job.Service, jobs),
+      // Receipt-only services are never called by this cancellation-domain test.
+      Effect.provideService(Database.Service, {} as Database.Interface),
+      Effect.provideService(KV.Service, {} as KV.Interface),
+      Effect.provideService(SessionStore.Service, {} as SessionStore.Interface),
+      Effect.provideService(Permission.Service, {
+        forSession: () => Effect.succeed([]),
+      } as unknown as Permission.Interface),
+      Effect.provideService(Form.Service, { list: () => Effect.succeed([]) } as unknown as Form.Interface),
+    ),
+  )
+  const evidence = await Effect.runPromise(domain.stop({ rootID: "ses_root", generation: 0 }))
+  expect(evidence).toMatchObject({ stopped: true, settled: true, uncertain: false, pending: 0 })
+  expect(new Set(cancelled)).toEqual(new Set(["ses_root", "ses_child", "ses_nested"]))
+  expect(new Set(interrupted)).toEqual(new Set(["ses_root", "ses_child", "ses_nested"]))
+  expect(pending.map((row) => row.id)).toEqual(["ses_foreign"])
+  await expect(Effect.runPromise(domain.inspect({ rootID: "ses_foreign", generation: 0 }))).rejects.toThrow()
+})
