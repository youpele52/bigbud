+export * as NativeFamilyShell from "./family.shell.js"
+import { Effect, Option } from "effect"
+import { NativeFamily } from "./family.js"
+
+/** Until Job.start owns a shell, the tool's scope owns physical cleanup. A failed
+ * handoff cleanup is durable uncertainty, never permission to settle or rearm. */
+export function handoff<A, E, R>(sessionID: string, run: (fault: () => Effect.Effect<void>) => Effect.Effect<A, E, R>) {
+  return Effect.gen(function* () {
+    const family = Option.getOrUndefined(yield* Effect.serviceOption(NativeFamily.Service))
+    const fault = family ? yield* Effect.promise(() => family.shellAdmission(sessionID)) : undefined
+    return yield* Effect.scoped(run(() => (fault ? Effect.promise(fault) : Effect.void)))
+  })
+}
