+import type { FamilyTicket } from "@opencode/plugin/family"
+export interface Operation {
+  ticket: FamilyTicket
+  childID?: string
+  jobGeneration?: number
+  notificationID?: string
+  done: boolean
+}
+export interface Snapshot {
+  abi: "opencode.native-family.v1"
+  rootID: string
+  ownerID: string
+  generation: number
+  inputID: string
+  stopped: boolean
+  settled: boolean
+  uncertain: boolean
+  operations: Operation[]
+}
+export interface Store {
+  get(key: string): Promise<unknown>
+  put(key: string, value: unknown): Promise<void>
+}
+export interface Drain {
+  cancel(children: readonly string[], notifications: readonly string[]): Promise<void>
+  drained(children: readonly string[], notifications: readonly string[]): Promise<boolean>
+}
