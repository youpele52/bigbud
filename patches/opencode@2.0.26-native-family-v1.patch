+export * as ShellLifetime from "./shell.lifetime.js"
+import { Deferred, Effect } from "effect"
+import { Shell } from "@opencode/schema/shell"
+import type { AppProcess } from "@opencode/util/process"
+import type { Active, NotFoundError } from "./shell.state.js"
+
+/** Creation remains interruptible (including permission waits), but a started
+ * process cannot lose its cleanup owner while its creation acknowledgement is late. */
+export function created(
+  ready: Deferred.Deferred<Active, AppProcess.AppProcessError>,
+  remove: (id: Shell.ID) => Effect.Effect<void, NotFoundError>,
+  fault?: () => Effect.Effect<void>,
+) {
+  return Deferred.await(ready).pipe(
+    Effect.onInterrupt(() =>
+      Deferred.await(ready).pipe(
+        Effect.flatMap((command) => remove(command.info.id)),
+        Effect.catchTag("AppProcessError", () => Effect.void),
+        Effect.catchTag("Shell.NotFoundError", () => Effect.void),
+        Effect.catchCause((cause) => (fault ? fault() : Effect.void).pipe(Effect.andThen(Effect.failCause(cause)))),
+      ),
+    ),
+  )
+}
