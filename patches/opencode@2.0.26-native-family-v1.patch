+export * as NativeFamilyDelivery from "./family.delivery.js"
+import { Effect, Option } from "effect"
+import { Job } from "../job.js"
+import { KV } from "../kv.js"
+import { Session } from "../session.js"
+import { SessionExecution } from "./execution.js"
+import { NativeFamilyAdmission } from "./family.admission.js"
+import { NativeFamily } from "./family.js"
+type Input = {
+  recovery: Extract<Job.Recovery, { kind: "subagent" }>
+  notificationID?: string
+  status: Job.Status
+  resume?: boolean
+}
+export type Deliver = (input: Input, message: Parameters<Session.Interface["synthetic"]>[0]) => Effect.Effect<void>
+export const make = Effect.fn("NativeFamilyDelivery.make")(function* () {
+  const ledger = Option.getOrUndefined(yield* Effect.serviceOption(NativeFamily.Service))
+  const execution = Option.getOrUndefined(yield* Effect.serviceOption(SessionExecution.Service))
+  const kv = Option.getOrUndefined(yield* Effect.serviceOption(KV.Service))
+  if (!ledger || !execution || !kv) return undefined
+  const sessions = yield* Session.Service
+  const jobs = yield* Job.Service
+  const run = Effect.runPromiseWith(yield* Effect.context())
+  const deliver: Deliver = (input, message) =>
+    Effect.promise(async () => {
+      if (!input.recovery.family || !input.notificationID || input.status === "running")
+        throw new Error("Native family completion capability missing")
+      const status = input.status
+      await ledger.deliver(
+        input.recovery.family,
+        input.recovery.childSessionID,
+        input.notificationID,
+        status,
+        async (receipt, guard) => {
+          const proof = await run(
+            NativeFamilyAdmission.proof(receipt, guard, message).pipe(Effect.provideService(KV.Service, kv)),
+          )
+          await run(sessions.nativeSynthetic({ ...message, resume: false }, proof))
+        },
+        () => (input.resume === false ? Promise.resolve() : run(execution.wake(input.recovery.parentSessionID))),
+      )
+      await run(jobs.completeBackground(message.id!))
+      await ledger.acknowledge(input.recovery.family, input.notificationID)
+    })
+  return deliver
+})
