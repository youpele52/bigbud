@@ -0,0 +1,63 @@
+export * as NativeFamilyRecovery from "./family.recovery.js"
+
+import type { FamilyTicket } from "@opencode/plugin/family"
+import { Effect, Schema } from "effect"
+import { Job } from "../job.js"
+import { KV } from "../kv.js"
+import { NativeFamily } from "./family.js"
+import { SessionMessage } from "./message.js"
+import { SessionSchema } from "./schema.js"
+import { SessionStore } from "./store.js"
+
+const ShellOwner = Schema.Struct({
+  abi: Schema.Literal("opencode.native-family.v1"),
+  rootID: Schema.String,
+  operations: Schema.Array(Schema.Struct({ childID: Schema.optionalKey(Schema.String) })),
+})
+
+/** A missing/deleted ordinary session still recovers as before, but missing
+ * ancestry or unreadable ownership must not erase a managed shell obligation. */
+export const shellGuard = Effect.fn("NativeFamilyRecovery.shellGuard")(function* () {
+  const families = yield* NativeFamily.Service
+  const store = yield* SessionStore.Service
+  const kv = yield* KV.Service
+  return (id: SessionSchema.ID) =>
+    Effect.gen(function* () {
+      const owned = yield* Effect.exit(Effect.promise(() => families.managed(id)))
+      if (owned._tag === "Success") return owned.value
+      if (yield* store.get(id)) return true
+      // Deleted ancestry is resolved against native-private ownership, never a
+      // synthetic notification. Failure/malformed inventory is retained uncertainty.
+      let after: string | undefined
+      do {
+        const page = yield* kv.scan({ prefix: "native-family.v1/root/", ...(after ? { after } : {}) })
+        for (const entry of page.entries) {
+          if (!Schema.is(ShellOwner)(entry.value) || entry.key !== `native-family.v1/root/${entry.value.rootID}`)
+            return true
+          if (entry.value.rootID === id || entry.value.operations.some((op) => op.childID === id)) return true
+        }
+        if (page.next && page.next === after) return true
+        after = page.next
+      } while (after)
+      return false
+    }).pipe(Effect.catchCause(() => Effect.succeed(true)))
+})
+
+/** Failed reads or fenced delivery are not acknowledgements. Keep private recovery
+ * records unless the journal positively proves this owner/generation is retired. */
+export const make = Effect.fn("NativeFamilyRecovery.make")(function* () {
+  const families = yield* NativeFamily.Service
+  const jobs = yield* Job.Service
+  return <E, R>(ticket: FamilyTicket, notificationID: string, recovery: Effect.Effect<void, E, R>) =>
+    recovery.pipe(
+      Effect.catchCause((cause) =>
+        Effect.gen(function* () {
+          const retired = yield* Effect.promise(() => families.retired(ticket)).pipe(
+            Effect.catchCause(() => Effect.succeed(false)),
+          )
+          if (retired) yield* jobs.completeBackground(SessionMessage.ID.make(notificationID))
+          else yield* Effect.logWarning("Native family recovery deferred; durable notification retained", cause)
+        }),
+      ),
+    )
+})
