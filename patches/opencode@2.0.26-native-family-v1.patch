+import { expect } from "bun:test"
+import { Deferred, Effect, Fiber } from "effect"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { AppNodeBuilder } from "../src/effect/app-node-builder"
+import { Database } from "../src/database/database"
+import { KV } from "../src/kv"
+import { Job } from "../src/job"
+import { NativeFamilyJobs } from "../src/session/family.jobs"
+import { NativeFamilyLedger } from "../src/session/family.ledger"
+import { SessionSchema } from "../src/session/schema"
+import { testEffect } from "./lib/effect"
+
+// Actual scoped Job registry and SQLite KV, with fake shell termination effects.
+// No shell command, native host, provider, model or real child process is launched.
+const it = testEffect(AppNodeBuilder.build(LayerNode.group([Database.node, KV.node, Job.node])))
+it.live("root, child and nested background shells drain by native job identity, without touching foreign jobs", () =>
+  Effect.gen(function* () {
+    const jobs = yield* Job.Service
+    const shellJobs = yield* NativeFamilyJobs.make()
+    const removed: string[] = []
+    for (const [session, id] of [
+      ["ses_root", "sh_root"],
+      ["ses_child", "sh_child"],
+      ["ses_nested", "sh_nested"],
+      ["ses_foreign", "sh_foreign"],
+    ]) {
+      yield* jobs.start({
+        id,
+        type: "shell",
+        recovery: { kind: "shell", sessionID: SessionSchema.ID.make(session), shellID: id, command: "SCRIPTED ONLY" },
+        run: Effect.never.pipe(
+          Effect.onInterrupt(() =>
+            Effect.sync(() => {
+              removed.push(id)
+            }),
+          ),
+        ),
+      })
+      if (id === "sh_child") {
+        const blocker = yield* jobs.block({ id, sessionID: SessionSchema.ID.make(session) }).pipe(Effect.forkScoped)
+        yield* Effect.yieldNow
+        yield* jobs.backgroundAll({ sessionID: SessionSchema.ID.make(session) })
+        yield* Fiber.join(blocker)
+      } else yield* jobs.background(id)
+    }
+    const targets = ["ses_root", "ses_child", "ses_nested"]
+    const pending = yield* Effect.promise(() =>
+      shellJobs.project(
+        {
+          abi: "opencode.native-family.v1",
+          rootID: "ses_root",
+          ownerID: "plugin",
+          generation: 0,
+          stopped: false,
+          settled: false,
+          uncertain: false,
+          pending: 0,
+          pendingBySession: {},
+        },
+        targets,
+      ),
+    )
+    expect(pending.pending).toBe(3)
+    expect(pending.pendingBySession).toEqual({ ses_root: 1, ses_child: 1, ses_nested: 1 })
+    yield* Effect.promise(() => shellJobs.cancel(targets))
+    expect(yield* Effect.promise(() => shellJobs.drained(targets))).toBe(true)
+    expect(new Set(removed)).toEqual(new Set(["sh_root", "sh_child", "sh_nested"]))
+    expect((yield* jobs.get("sh_foreign"))?.status).toBe("running")
+    expect((yield* jobs.pendingBackground).map((row) => row.id)).toEqual(["sh_foreign"])
+  }),
+)
+
+it.live("Stop waits for physical termination and retains failed cancellation evidence across ledger recovery", () =>
+  Effect.gen(function* () {
+    const jobs = yield* Job.Service
+    const kv = yield* KV.Service
+    const shellJobs = yield* NativeFamilyJobs.make()
+    const run = Effect.runPromiseWith(yield* Effect.context())
+    const ledger = new NativeFamilyLedger.Ledger(
+      { get: (key) => run(kv.get(key)), put: (key, value) => run(kv.set(key, value as KV.Value)) },
+      async () => undefined,
+    )
+    yield* Effect.promise(() => ledger.register("plugin", "ses_root", 0, "msg_user"))
+    const termination = yield* Deferred.make<void>()
+    let acknowledged = false
+    yield* jobs.start({
+      id: "sh_slow",
+      type: "shell",
+      recovery: {
+        kind: "shell",
+        sessionID: SessionSchema.ID.make("ses_root"),
+        shellID: "sh_slow",
+        command: "SCRIPTED ONLY",
+      },
+      run: Effect.never.pipe(Effect.onInterrupt(() => Deferred.await(termination))),
+    })
+    yield* jobs.background("sh_slow")
+    const stopping = yield* Effect.promise(() =>
+      ledger.stop("plugin", "ses_root", 0, {
+        cancel: () => shellJobs.cancel(["ses_root"]),
+        drained: () => shellJobs.drained(["ses_root"]),
+      }),
+    ).pipe(
+      Effect.tap(() =>
+        Effect.sync(() => {
+          acknowledged = true
+        }),
+      ),
+      Effect.forkScoped,
+    )
+    yield* Effect.yieldNow
+    expect(acknowledged).toBe(false)
+    yield* Deferred.succeed(termination, undefined)
+    expect((yield* Fiber.join(stopping)).settled).toBe(true)
+    yield* Effect.promise(() => ledger.register("plugin", "ses_root", 1, "msg_next"))
+    yield* jobs.start({
+      id: "sh_failed_ack",
+      type: "shell",
+      recovery: {
+        kind: "shell",
+        sessionID: SessionSchema.ID.make("ses_root"),
+        shellID: "sh_failed_ack",
+        command: "SCRIPTED ONLY",
+      },
+      run: Effect.never.pipe(Effect.onInterrupt(() => Effect.die(new Error("physical termination unconfirmed")))),
+    })
+    yield* jobs.background("sh_failed_ack")
+    const evidence = yield* Effect.promise(() =>
+      ledger.stop("plugin", "ses_root", 1, {
+        cancel: () => shellJobs.cancel(["ses_root"]),
+        drained: () => shellJobs.drained(["ses_root"]),
+      }),
+    )
+    expect(evidence).toMatchObject({ settled: false, uncertain: true })
+    expect((yield* jobs.pendingBackground).find((row) => row.id === "sh_failed_ack")?.cancellationPending).toBe(true)
+    const recoveredJobs = yield* Job.make
+    const recovered = yield* NativeFamilyJobs.make().pipe(Effect.provideService(Job.Service, recoveredJobs))
+    expect(yield* Effect.promise(() => recovered.drained(["ses_root"]))).toBe(false)
+    const reopened = new NativeFamilyLedger.Ledger(
+      { get: (key) => run(kv.get(key)), put: (key, value) => run(kv.set(key, value as KV.Value)) },
+      async () => undefined,
+    )
+    expect((yield* Effect.promise(() => reopened.inspect("plugin", "ses_root", 1))).uncertain).toBe(true)
+    expect(
+      (yield* Effect.exit(Effect.promise(() => reopened.register("plugin", "ses_root", 2, "msg_forbidden"))))._tag,
+    ).toBe("Failure")
+  }),
+)
+
+it.live("journal read/write failures never suppress a live shell termination attempt", () =>
+  Effect.gen(function* () {
+    const kv = yield* KV.Service
+    let failed = false
+    const flaky = KV.Service.of({
+      ...kv,
+      set: (key, value) => (failed ? Effect.die(new Error("ENOSPC")) : kv.set(key, value)),
+      scan: (options) => (failed ? Effect.die(new Error("EIO")) : kv.scan(options)),
+    })
+    const jobs = yield* Job.make.pipe(Effect.provideService(KV.Service, flaky))
+    const shells = yield* NativeFamilyJobs.make().pipe(Effect.provideService(Job.Service, jobs))
+    let terminated = false
+    yield* jobs.start({
+      id: "sh_journal_failure",
+      type: "shell",
+      recovery: {
+        kind: "shell",
+        sessionID: SessionSchema.ID.make("ses_root"),
+        shellID: "sh_journal_failure",
+        command: "SCRIPTED ONLY",
+      },
+      run: Effect.never.pipe(
+        Effect.onInterrupt(() =>
+          Effect.sync(() => {
+            terminated = true
+          }),
+        ),
+      ),
+    })
+    yield* jobs.background("sh_journal_failure")
+    failed = true
+    expect((yield* Effect.exit(Effect.promise(() => shells.cancel(["ses_root"]))))._tag).toBe("Failure")
+    expect(terminated).toBe(true)
+    failed = false
+    expect((yield* jobs.pendingBackground).some((row) => row.id === "sh_journal_failure")).toBe(true)
+  }),
+)
