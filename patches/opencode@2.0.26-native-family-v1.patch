+import { expect, test } from "bun:test"
+import { Effect } from "effect"
+import { NativeFamilyLedger } from "../src/session/family.ledger"
+import { SessionRunCoordinator } from "../src/session/run-coordinator"
+
+// Pure source coordinator plus scripted ledger store; no native application or model.
+test("a delayed native wake cannot cross Stop/rearm at the coordinator's actual execution boundary", async () => {
+  const store = new Map<string, unknown>()
+  const ledger = new NativeFamilyLedger.Ledger(
+    {
+      get: async (key) => store.get(key),
+      put: async (key, value) => {
+        store.set(key, structuredClone(value))
+      },
+    },
+    async () => undefined,
+  )
+  const unowned = await ledger.runnableGuard("root")
+  await ledger.register("plugin", "root", 0, "msg_first")
+  expect(unowned).toThrow()
+  const stale = await ledger.runnableGuard("root")
+  await ledger.stop("plugin", "root", 0, { cancel: async () => {}, drained: async () => true })
+  await ledger.register("plugin", "root", 1, "msg_new")
+  let attempts = 0
+  const fresh = await ledger.runnableGuard("root")
+  await Effect.runPromise(
+    Effect.scoped(
+      Effect.gen(function* () {
+        const coordinator = yield* SessionRunCoordinator.make<string, never>({
+          drain: () =>
+            Effect.sync(() => {
+              attempts++
+            }),
+        })
+        expect((yield* Effect.exit(coordinator.wake("root", "input", stale)))._tag).toBe("Failure")
+        expect((yield* coordinator.active).size).toBe(0)
+        yield* coordinator.wake("root", "input", fresh)
+        yield* coordinator.awaitIdle("root")
+        expect(attempts).toBe(1)
+      }),
+    ),
+  )
+})
