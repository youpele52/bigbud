+export * as NativeFamilyJobs from "./family.jobs.js"
+
+import { Effect } from "effect"
+import { Job } from "../job.js"
+import type { FamilyEvidence } from "@opencode/plugin/family"
+
+/** Live shell job IDs differ from Session IDs. Keep recovery records until the
+ * exact live job's scope (including physical shell termination) has closed. */
+export const make = Effect.fn("NativeFamilyJobs.make")(function* () {
+  const jobs = yield* Job.Service
+  const run = Effect.runPromiseWith(yield* Effect.context())
+  const cancel = async (targets: readonly string[]) => {
+    const live = await run(jobs.forSessions(targets))
+    const results = await Promise.allSettled(
+      live.map(async (job) => {
+        await run(jobs.cancel(job.id))
+        if (job.notificationID) await run(jobs.completeBackground(job.notificationID))
+      }),
+    )
+    // Read failures cannot suppress cancellation of the live identities above.
+    const pending = (await run(jobs.pendingBackground)).filter(
+      (job) => job.recovery.kind === "shell" && targets.includes(job.recovery.sessionID),
+    )
+    // Recovered running shell records with no live cancellation authority are not
+    // evidence of physical termination. Retain them rather than invent an ack.
+    for (const job of pending) {
+      if (live.some((entry) => entry.id === job.id && entry.notificationID === job.notificationID)) continue
+      if (job.status !== "running" && !job.cancellationPending) await run(jobs.completeBackground(job.notificationID))
+    }
+    if (results.some((result) => result.status === "rejected"))
+      throw new Error("Native family shell termination uncertain")
+  }
+  return {
+    project: async (evidence: FamilyEvidence, targets: readonly string[]) => {
+      const live = await run(jobs.forSessions(targets))
+      const persisted = await run(jobs.pendingBackground)
+      const owned = new Map<string, string>()
+      for (const job of live)
+        if (job.status === "running" && job.recovery.kind === "shell") owned.set(job.id, job.recovery.sessionID)
+      for (const job of persisted)
+        if (job.recovery.kind === "shell" && targets.includes(job.recovery.sessionID))
+          owned.set(job.id, job.recovery.sessionID)
+      const pendingBySession = { ...evidence.pendingBySession }
+      for (const id of owned.values()) pendingBySession[id] = (pendingBySession[id] ?? 0) + 1
+      return { ...evidence, pending: evidence.pending + owned.size, pendingBySession }
+    },
+    cancel,
+    drained: async (targets: readonly string[]) => {
+      await cancel(targets)
+      return (
+        !(await run(jobs.forSessions(targets))).some((job) => job.status === "running") &&
+        !(await run(jobs.pendingBackground)).some(
+          (job) => job.recovery.kind === "shell" && targets.includes(job.recovery.sessionID),
+        )
+      )
+    },
+  }
+})
