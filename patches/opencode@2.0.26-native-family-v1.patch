--- /dev/null
+++ b/packages/core/src/session/family.plugin.ts
@@ -0,0 +1,141 @@
+export * as NativeFamilyPlugin from "./family.plugin.js"
+
+import type { FamilyDomain } from "@opencode/plugin/effect/family"
+import { Effect } from "effect"
+import { Database } from "../database/database.js"
+import { Form } from "../form.js"
+import { Job } from "../job.js"
+import { KV } from "../kv.js"
+import { Permission } from "../permission.js"
+import { Session } from "../session.js"
+import { NativeFamilyAdmission } from "./family.admission.js"
+import { NativeFamilyJobs } from "./family.jobs.js"
+import { NativeFamily } from "./family.js"
+import { nativeFamilySourceDigest } from "./family.source.js"
+import { SessionSchema } from "./schema.js"
+import { SessionStore } from "./store.js"
+
+/** The host binds owner identity and Location; callers cannot query another plugin's jobs. */
+export const make = Effect.fn("NativeFamilyPlugin.make")(function* (ownerID: string, directory: string) {
+  const ledger = yield* NativeFamily.Service
+  const sessions = yield* Session.Service
+  const jobs = yield* Job.Service
+  const permissions = yield* Permission.Service
+  const forms = yield* Form.Service
+  const database = yield* Database.Service
+  const kv = yield* KV.Service
+  const store = yield* SessionStore.Service
+  const shellJobs = yield* NativeFamilyJobs.make()
+  const run = Effect.runPromiseWith(yield* Effect.context())
+  const verify = async (rootID: string) => {
+    const root = await run(sessions.get(SessionSchema.ID.make(rootID)))
+    if (root.parentID || root.fork || root.location.directory !== directory)
+      throw new Error("Native family Location/root rejected")
+  }
+  const domain: FamilyDomain = {
+    abi: "opencode.native-family.v1",
+    sourceDigest: nativeFamilySourceDigest,
+    register: (input) =>
+      Effect.promise(async () => {
+        await verify(input.rootID)
+        try {
+          await ledger.inspect(ownerID, input.rootID, input.generation)
+        } catch {
+          if (
+            (await run(jobs.pendingBackground)).some(
+              (job) => job.recovery.kind === "subagent" && job.recovery.family?.rootID === input.rootID,
+            )
+          )
+            throw new Error("Native family recovery records require their existing durable root")
+        }
+        return ledger.register(ownerID, input.rootID, input.generation, input.inputID)
+      }),
+    inspect: (input) =>
+      Effect.promise(async () => {
+        await verify(input.rootID)
+        const evidence = await ledger.inspect(ownerID, input.rootID, input.generation)
+        return shellJobs.project(evidence, await ledger.sessionIDs(ownerID, input.rootID, input.generation))
+      }),
+    receipt: (input) =>
+      Effect.promise(async () => {
+        await verify(input.rootID)
+        const receipt = await ledger.receipt(ownerID, input.rootID, input.generation, input.inputID)
+        await run(
+          NativeFamilyAdmission.verify(receipt).pipe(
+            Effect.provideService(Database.Service, database),
+            Effect.provideService(KV.Service, kv),
+            Effect.provideService(SessionStore.Service, store),
+          ),
+        )
+        return receipt
+      }),
+    stop: (input) =>
+      Effect.promise(async () => {
+        await verify(input.rootID)
+        return ledger.stop(ownerID, input.rootID, input.generation, {
+          cancel: async (children) => {
+            const targets = [input.rootID, ...children]
+            // Targets come from the authenticated native-private generation, not
+            // caller metadata. A later failed read must not suppress these attempts.
+            const results = await Promise.allSettled(
+              targets.flatMap((id) => [
+                run(sessions.interrupt(SessionSchema.ID.make(id), { resume: false })),
+                run(jobs.cancel(id)),
+                shellJobs.cancel([id]),
+              ]),
+            )
+            // Persisted observers are private native recovery records, not discovered sessions.
+            for (const pending of await run(jobs.pendingBackground)) {
+              if (
+                pending.recovery.kind !== "subagent" ||
+                pending.recovery.family?.rootID !== input.rootID ||
+                pending.recovery.family.ownerID !== ownerID ||
+                pending.recovery.family.generation !== input.generation
+              )
+                continue
+              await run(jobs.completeBackground(pending.notificationID))
+            }
+            for (const id of targets) {
+              if ((await run(sessions.get(SessionSchema.ID.make(id)))).location.directory !== directory)
+                throw new Error("Native family descendant Location changed")
+              for (const item of await run(sessions.inbox(SessionSchema.ID.make(id))))
+                await run(sessions.cancelInbox({ sessionID: SessionSchema.ID.make(id), inboxID: item.id }))
+              for (const request of await run(permissions.forSession(SessionSchema.ID.make(id))))
+                await run(permissions.reply({ requestID: request.id, reply: "reject" }))
+              for (const form of await run(forms.list({ sessionID: SessionSchema.ID.make(id) })))
+                if ((await run(forms.state(form.id))).status === "pending") await run(forms.cancel(form.id))
+            }
+            if (results.some((result) => result.status === "rejected"))
+              throw new Error("Native family cancellation uncertain")
+          },
+          drained: async (children) => {
+            const targets = [input.rootID, ...children]
+            for (let attempt = 0; attempt < 100; attempt++) {
+              const active = await run(sessions.active)
+              if (targets.every((id) => !active.has(SessionSchema.ID.make(id)))) {
+                if (!(await shellJobs.drained(targets))) return false
+                for (const id of targets)
+                  if ((await run(sessions.inbox(SessionSchema.ID.make(id)))).length) return false
+                const pending = await run(jobs.pendingBackground)
+                for (const id of targets) {
+                  if ((await run(permissions.forSession(SessionSchema.ID.make(id)))).length) return false
+                  for (const form of await run(forms.list({ sessionID: SessionSchema.ID.make(id) })))
+                    if ((await run(forms.state(form.id))).status === "pending") return false
+                }
+                return !pending.some(
+                  (job) =>
+                    job.recovery.kind === "subagent" &&
+                    job.recovery.family?.rootID === input.rootID &&
+                    job.recovery.family.ownerID === ownerID &&
+                    job.recovery.family.generation === input.generation,
+                )
+              }
+              await new Promise((resolve) => setTimeout(resolve, 50))
+            }
+            return false
+          },
+        })
+      }),
+  }
+  return domain
+})
