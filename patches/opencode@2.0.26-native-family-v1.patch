+++ b/packages/core/src/session/family.receipt.ts
@@ -0,0 +1,103 @@
+export * as NativeFamilyReceipt from "./family.receipt.js"
+
+import type { FamilyEvidence, FamilyReceipt, FamilyTicket } from "@opencode/plugin/family"
+import { createHash } from "node:crypto"
+
+export async function root(parent: (id: string) => Promise<string | undefined>, id: string) {
+  const seen = new Set<string>()
+  for (let depth = 0; depth <= 16; depth++) {
+    if (seen.has(id)) throw new Error("Native family ancestry rejected")
+    seen.add(id)
+    const next = await parent(id)
+    if (!next) return id
+    id = next
+  }
+  throw new Error("Native family depth rejected")
+}
+import type { Snapshot, Store } from "./family.ledger.types.js"
+
+export function evidence(state: Snapshot, fenced: boolean, failed: boolean): FamilyEvidence {
+  const pendingBySession: Record<string, number> = {}
+  for (const op of state.operations) {
+    if (op.done) continue
+    for (const id of new Set([op.ticket.parentID, ...(op.childID ? [op.childID] : [])]))
+      pendingBySession[id] = (pendingBySession[id] ?? 0) + 1
+  }
+  return {
+    abi: state.abi,
+    rootID: state.rootID,
+    ownerID: state.ownerID,
+    generation: state.generation,
+    stopped: state.stopped || fenced,
+    settled: state.settled && !failed,
+    uncertain: state.uncertain || failed,
+    pending: state.operations.filter((op) => !op.done).length,
+    pendingBySession,
+  }
+}
+
+/** Canonical native payload binding survives JSON projection and metadata key order. */
+export function payloadDigest(input: { text: string; description?: string; metadata?: Record<string, unknown> }) {
+  const canonical = (value: unknown): unknown =>
+    Array.isArray(value)
+      ? value.map(canonical)
+      : value && typeof value === "object"
+        ? Object.fromEntries(
+            Object.entries(value)
+              .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))
+              .map(([key, entry]) => [key, canonical(entry)]),
+          )
+        : value
+  return createHash("sha256")
+    .update(JSON.stringify(canonical([input.text, input.description ?? null, input.metadata ?? null])))
+    .digest("hex")
+}
+
+export function verifyPayload(
+  binding: unknown,
+  receipt: FamilyReceipt,
+  body: Parameters<typeof payloadDigest>[0] | undefined,
+) {
+  if (
+    !binding ||
+    typeof binding !== "object" ||
+    !("digest" in binding) ||
+    !("operationID" in binding) ||
+    !("sessionID" in binding) ||
+    binding.operationID !== receipt.operationID ||
+    binding.sessionID !== receipt.parentID ||
+    !body ||
+    payloadDigest(body) !== binding.digest
+  )
+    throw new Error("Native family admission payload changed")
+}
+
+export function operation(state: Snapshot, ticket: FamilyTicket) {
+  const entry = state.operations.find((op) => op.ticket.operationID === ticket.operationID)
+  if (!entry || Object.entries(entry.ticket).some(([key, value]) => ticket[key as keyof FamilyTicket] !== value))
+    throw new Error("Native family operation provenance rejected")
+  return entry
+}
+
+/** Read native-private admission provenance; caller metadata is never consulted. */
+export async function read(state: Snapshot, store: Store, inputID: string): Promise<FamilyReceipt> {
+  if (await store.get(`native-family.v1/cancelled/${inputID}`)) throw new Error("Native family admission was cancelled")
+  const proof = (await store.get(`native-family.v1/origin/${inputID}`)) as FamilyReceipt | undefined
+  if (
+    !proof ||
+    proof.rootID !== state.rootID ||
+    proof.ownerID !== state.ownerID ||
+    proof.generation !== state.generation ||
+    proof.notificationID !== inputID
+  )
+    throw new Error("Native family input has no authenticated admission receipt")
+  const entry = operation(state, proof)
+  if (
+    entry.childID !== proof.childID ||
+    entry.notificationID !== inputID ||
+    entry.jobGeneration !== proof.jobGeneration
+  )
+    throw new Error("Native family input receipt changed job generation")
+  const consumed = (await store.get(`native-family.v1/consumed/${inputID}`)) as { operationID?: string } | undefined
+  return { ...proof, consumed: consumed?.operationID === proof.operationID }
+}
