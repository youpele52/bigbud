+import { buildExecution, it, seedBackground, seedSessions } from "./session-execution.fixture"
+
+// Actual SQLite and fresh Job registry. Command strings are never executed.
+for (const stopped of [false, true]) {
+  it.effect(`restart preserves managed root/child running shells without cancel markers (stopped=${stopped})`, () =>
+    Effect.gen(function* () {
+      const database = yield* Database.Service
+      const kv = yield* KV.Service
+      const jobs = yield* Job.Service
+      const family = yield* NativeFamily.Service
+      const root = Session.ID.make("ses_managed_shell_root")
+      const child = Session.ID.make("ses_managed_shell_child")
+      const foreign = Session.ID.make("ses_ordinary_shell_owner")
+      yield* seedSessions(database, [root, foreign])
+      yield* seedSessions(database, [child], { parent_id: root })
+      yield* Effect.promise(() => family.register("plugin", root, 0, "msg_root"))
+      const ticket = (yield* Effect.promise(() => family.begin(root, "msg_root", "call_child")))!
+      yield* Effect.promise(() => family.enroll(ticket, child))
+      for (const id of [root, child, foreign])
+        yield* seedBackground(jobs, id, [{ id: `sh_${id}`, shellID: `sh_${id}`, command: "SCRIPTED ONLY" }])
+      if (stopped) {
+        const evidence = yield* Effect.promise(() =>
+          family.stop("plugin", root, 0, {
+            // Simulate death AFTER stopped is durable but BEFORE Job.cancel journals.
+            cancel: async () => {
+              throw new Error("crash before cancellation")
+            },
+            drained: async () => false,
+          }),
+        )
+        expect(evidence).toMatchObject({ stopped: true, settled: false })
+      }
+      const scope = yield* Scope.make()
+      yield* Effect.addFinalizer(() => Scope.close(scope, Exit.void))
+      const freshJobs = yield* Job.make.pipe(Effect.provideService(Scope.Scope, scope))
+      expect(yield* freshJobs.get(`sh_${root}`)).toBeUndefined()
+      const context = yield* buildExecution(scope, () => Effect.void, undefined, freshJobs)
+      yield* Context.get(context, SessionRestart.Service).resumeSuspendedSessions
+      yield* Context.get(context, SessionRestart.Service).resumeSuspendedSessions
+      const pending = yield* freshJobs.pendingBackground
+      expect(
+        pending.flatMap((job) => (job.recovery.kind === "shell" ? [job.recovery.sessionID] : [])).toSorted(),
+      ).toEqual([root, child].toSorted())
+      expect(pending.every((job) => job.status === "running" && !job.cancellationPending)).toBe(true)
+      for (const id of [root, child]) expect(yield* SessionInbox.list(database.db, id)).toEqual([])
+      expect(yield* SessionInbox.list(database.db, foreign)).toHaveLength(1)
+      const run = Effect.runPromiseWith(yield* Effect.context())
+      const reopened = new NativeFamilyLedger.Ledger(
+        { get: (key) => run(kv.get(key)), put: (key, value) => run(kv.set(key, value as KV.Value)) },
+        async (id) => (id === child ? root : undefined),
+      )
+      const shells = yield* NativeFamilyJobs.make().pipe(Effect.provideService(Job.Service, freshJobs))
+      const retry = yield* Effect.promise(() =>
+        reopened.stop("plugin", root, 0, {
+          cancel: () => shells.cancel([root, child]),
+          drained: () => shells.drained([root, child]),
+        }),
+      )
+      expect(retry).toMatchObject({ stopped: true, settled: false, uncertain: true })
+      expect((yield* Effect.exit(Effect.promise(() => reopened.register("plugin", root, 1, "msg_next"))))._tag).toBe(
+        "Failure",
+      )
+      expect(yield* freshJobs.pendingBackground).toHaveLength(2)
+    }),
+  )
+}
+
+it.effect("unreadable managed ownership retains its running shell without aborting ordinary recovery", () =>
+  Effect.gen(function* () {
