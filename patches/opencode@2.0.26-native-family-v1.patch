+/** Native-owned subagent lifecycle ABI. This is not caller-supplied message metadata. */
+export const FAMILY_ABI = "opencode.native-family.v1" as const
+export interface FamilyTicket {
+  readonly rootID: string
+  readonly ownerID: string
+  readonly generation: number
+  readonly operationID: string
+  readonly parentID: string
+  readonly messageID: string
+  readonly callID: string
+}
+export interface FamilyReceipt extends FamilyTicket {
+  readonly consumed?: boolean
+  readonly abi: typeof FAMILY_ABI
+  readonly childID: string
+  readonly notificationID: string
+  readonly jobGeneration: number
+  readonly status: "completed" | "error" | "cancelled"
+}
+export interface FamilyEvidence {
+  readonly pendingBySession: Readonly<Record<string, number>>
+  readonly abi: typeof FAMILY_ABI
+  readonly rootID: string
+  readonly ownerID: string
+  readonly generation: number
+  readonly stopped: boolean
+  readonly settled: boolean
+  readonly uncertain: boolean
+  readonly pending: number
+}
+export interface FamilyInput {
+  readonly rootID: string
+  readonly generation: number
+}
