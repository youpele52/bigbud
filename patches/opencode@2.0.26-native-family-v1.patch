@@ -0,0 +1,56 @@
+export * as SessionSynthetic from "./synthetic.js"
+
+import { Effect } from "effect"
+import { SyntheticConflictError, type NotFoundError } from "./error.js"
+import type { SessionExecution } from "./execution.js"
+import { SessionInbox } from "./inbox.js"
+import { SessionMessage } from "./message.js"
+import type { SessionSchema } from "./schema.js"
+
+export interface Input {
+  id?: SessionMessage.ID
+  text: string
+  description?: string
+  metadata?: Record<string, unknown>
+  delivery?: SessionInbox.Delivery
+  resume?: boolean
+}
+export interface Proof {
+  commit: () => Effect.Effect<void>
+  verifyExisting: () => Effect.Effect<void>
+}
+/** Public and native entrypoints share admission semantics; only the private native
+ * entrypoint accepts transaction hooks, which are never forwarded by plugin/HTTP APIs. */
+export function make(
+  get: (id: SessionSchema.ID) => Effect.Effect<SessionSchema.Info, NotFoundError>,
+  admission: SessionInbox.Interface,
+  execution: SessionExecution.Interface,
+) {
+  return (sessionID: SessionSchema.ID, input: Input, proof?: Proof) =>
+    Effect.uninterruptible(
+      Effect.gen(function* () {
+        yield* get(sessionID)
+        const inputID = input.id ?? SessionMessage.ID.create()
+        const admitted = yield* admission
+          .admit({
+            id: inputID,
+            sessionID,
+            item: {
+              type: "synthetic",
+              payload: SessionInbox.SyntheticPayload.make({
+                text: input.text,
+                description: input.description,
+                metadata: input.metadata,
+              }),
+              delivery: SessionInbox.Delivery.make(input.delivery ?? "steer"),
+            },
+            ...proof,
+          })
+          .pipe(
+            Effect.catchTag("SessionInbox.LifecycleConflict", () => new SyntheticConflictError({ sessionID, inputID })),
+          )
+        if (input.resume !== false && !(yield* get(sessionID)).revert) yield* execution.wake(sessionID)
+        return admitted
+      }),
+    )
+}
