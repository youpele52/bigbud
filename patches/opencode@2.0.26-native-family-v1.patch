+import { expect, test } from "bun:test"
+import { Effect } from "effect"
+import { Job } from "../src/job"
+import { NativeFamily } from "../src/session/family"
+import { NativeFamilyLedger } from "../src/session/family.ledger"
+import { NativeFamilyRecovery } from "../src/session/family.recovery"
+
+test("uncertain recovery preserves notifications; positively retired delivery does not abort unrelated recovery", async () => {
+  const values = new Map<string, unknown>()
+  let readable = true
+  const ledger = new NativeFamilyLedger.Ledger(
+    {
+      get: async (key) => {
+        if (!readable) throw new Error("journal unreadable")
+        return structuredClone(values.get(key))
+      },
+      put: async (key, value) => {
+        values.set(key, structuredClone(value))
+      },
+    },
+    async () => undefined,
+  )
+  await ledger.register("plugin", "root", 0, "user")
+  const ticket = (await ledger.begin("root", "message", "call"))!
+  const retired: string[] = []
+  const recover = await Effect.runPromise(
+    NativeFamilyRecovery.make().pipe(
+      Effect.provideService(NativeFamily.Service, ledger),
+      Effect.provideService(Job.Service, {
+        completeBackground: (id: string) =>
+          Effect.sync(() => {
+            retired.push(id)
+          }),
+      } as unknown as Job.Interface),
+    ),
+  )
+  const failure = Effect.die(new Error("Stop raced completion delivery"))
+  readable = false
+  await Effect.runPromise(recover(ticket, "msg_notification", failure))
+  expect(retired).toEqual([])
+  readable = true
+  await Effect.runPromise(recover(ticket, "msg_notification", failure))
+  expect(retired).toEqual([])
+  await ledger.stop("plugin", "root", 0, { cancel: async () => {}, drained: async () => true })
+  let unrelated = false
+  await Effect.runPromise(
+    recover(ticket, "msg_notification", failure).pipe(
+      Effect.andThen(
+        Effect.sync(() => {
+          unrelated = true
+        }),
+      ),
+    ),
+  )
+  expect(retired).toEqual(["msg_notification"])
+  expect(unrelated).toBe(true)
+  expect(await ledger.retired({ ...ticket, ownerID: "foreign" })).toBe(false)
+  expect(await ledger.retired({ ...ticket, generation: 1 })).toBe(false)
+})
